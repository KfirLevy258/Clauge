# The shims are written to the customer's machine byte-for-byte and run by
# /bin/sh (Git Bash on Windows), which fails on CRLF. Check everything out LF
# everywhere: Windows runners default to autocrlf, which turned every
# text file into CRLF at checkout and made the installed shim -- written LF
# on purpose -- differ from its own source.
* text=auto eol=lf
*.png binary
*.bin binary
*.pem binary

# WCH's driver package is signed, and CH341SER.CAT holds a hash of
# CH341SER.INF. The rule above checks every text file out as LF -- which
# rewrites that .INF, invalidates the catalogue, and makes Windows refuse the
# install with no useful message. The bytes have to survive untouched.
vendor/ch341ser/*.INF -text
vendor/ch341ser/*.CAT binary
vendor/ch341ser/*.SYS binary
vendor/ch341ser/*.DLL binary
