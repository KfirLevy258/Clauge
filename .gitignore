*.log

# Python
__pycache__/
*.pyc
# Never commit tokens (they're stored in ~/.config/live-claude-ui by default,
# but ignore any local copies just in case)
tokens.json
.env

# Firmware secrets (never commit real creds/token) + build artifacts
firmware/src/secrets.h
# A glob, not a list. The list named five build directories by hand, and the
# sixth and seventh (build-usb, build-wifi, added when the WiFi path became a
# Kconfig option) went straight into a commit: 5,065 files and 1.58 million
# lines of generated Zephyr output, in a public repository, permanently.
firmware/build*/
build*/

# Local-only: implementation plans reference the concerns doc (public repo)
docs/superpowers/
.superpowers/

# PyInstaller output; binaries are built per-platform in CI, never committed.
/dist/

# The running daemon's pid file. It was TRACKED, so every session with the
# service up left `git status` dirty and the number went into commits as
# whatever pid happened to be running on the author's machine -- which is not
# a fact about the project. `blink` writes it next to itself at runtime.
bridge.pid

# Local agent tooling, never part of the product
.claude/
.claude-flow/

# pip leftovers. Sixteen wheels and an esptool tarball (11 MB) went into a
# commit on 2026-08-22 from a `pip download` run in the repo root.
/*.whl
/*.tar.gz
